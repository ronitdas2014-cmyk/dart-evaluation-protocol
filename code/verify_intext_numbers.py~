#!/usr/bin/env python3
# verify_intext_numbers.py -- confirm the in-text / figure numbers a referee is
# most likely to check, beyond the seven tables. Grounded in main.tex claims.
#
# RUN:  python3 verify_intext_numbers.py --data DATA_DIR [--pjm_raw PJM_DIR]
#
# DATASETS
#   predictions_gate_closure_congestion.csv   -> #1 tail conc, #5 collapse, #6 ECE,
#                                                #7 precision, #8 PT-share, #9 block-SE, #13 n_dep
#   (raw PJM da/rt total)                      -> #2 forward premium, full-spread cap curve
#   Not automated here (point to the shipped files): RQ1 tail exponents rq1_by_node.csv;
#   stationarity_tests.csv; White RC / Hansen SPA (stationary bootstrap); vintage_probe.csv;
#   GMC/fee erosion or_rates_rto_2025_26.csv.
import sys, argparse, glob, numpy as np, pandas as pd
ap=argparse.ArgumentParser(); ap.add_argument('--data',default='./data/'); ap.add_argument('--pjm_raw',default=None)
A=ap.parse_args(); D=A.data.rstrip('/')+'/'
gc=pd.read_csv(D+'predictions_gate_closure_congestion.csv'); y=gc.y.values.astype(int); dart=gc.dart.values; N=len(gc); A0=0.5317
M=['persistence','climatology','logistic','gbm','rf','mlp','sarima','kalman','markov']
days=pd.factorize(pd.to_datetime(gc['datetime_beginning_utc']).dt.floor('D').values)[0]; nd=days.max()+1
o=np.argsort(days,kind='stable'); di=days[o]; st=np.searchsorted(di,np.arange(nd),'left'); sp=np.searchsorted(di,np.arange(nd),'right'); cnt=(sp-st).astype(float)
def se_block(v,L=5):
    ds=np.array([v[o][st[i]:sp[i]].sum() for i in range(nd)]); rng=np.random.default_rng(20260725); nb=int(np.ceil(nd/L)); e=np.empty(2000)
    for b in range(2000): bl=((rng.integers(0,nd,size=nb)[:,None]+np.arange(L))%nd).ravel(); e[b]=ds[bl].sum()/cnt[bl].sum()
    return e.std()

print("#1 TAIL CONCENTRATION of |DART|"); a=np.abs(dart); ordr=np.argsort(a)[::-1]
for q in (0.01,0.05,0.10): k=int(q*N); print(f"   top {int(q*100):>2}% hours hold {100*a[ordr[:k]].sum()/a.sum():.1f}% of |DART| mass")

print("\n#5 POOLED vs ZONE-CONDITIONAL EXCESS")
zmaj={z:(1 if g.y.mean()>0.5 else 0) for z,g in gc.groupby('zone')}; A_zc=(gc.zone.map(zmaj).values==y).mean()
for m in M:
    A=((gc['p_'+m]>0.5).astype(int)==y).mean(); dp=A-A0; dz=A-A_zc
    print(f"   {m:12} pooled Δ={dp:+.3f}  zone-cond Δ_zc={dz:+.3f}  collapse={(100*(1-dz/dp)) if dp!=0 else 0:>5.0f}%")

print("\n#6 CALIBRATION (ECE, 10-bin)")
for m in M:
    p=gc['p_'+m].values; b=np.clip((p*10).astype(int),0,9); ece=sum((b==k).mean()*abs(p[b==k].mean()-y[b==k].mean()) for k in range(10) if (b==k).any())
    print(f"   {m:12} ECE={ece:.3f}")

print("\n#7 PRECISION at top-confidence q  +  #8 PT prediction-share")
for m in M:
    p=gc['p_'+m].values; conf=np.abs(p-0.5); d=(p>0.5).astype(int)
    pr2=(d[conf>=np.quantile(conf,0.98)]==y[conf>=np.quantile(conf,0.98)]).mean()
    print(f"   {m:12} predicts-up={d.mean():.3f}  precision@top2%={pr2:.3f}")
print(f"   (base-rate up = {y.mean():.3f}; PT paradox = a model can reject independence yet predict up too rarely)")

print("\n#9 BLOCK-LENGTH SE (L=1 vs L=5): directional (hit) and value")
for m in ['logistic','markov']:
    h=(((gc['p_'+m]>0.5).astype(int))==y).astype(float)
    pv=(2*(gc['p_'+m].values>0.5)-1)*np.clip(dart,-np.quantile(a,0.99),np.quantile(a,0.99))
    for lbl,v in [('hit',h),('value',pv)]:
        s1,s5=se_block(v,1),se_block(v,5); print(f"   {m:8} {lbl:5} SE: L1={s1:.4f} L5={s5:.4f} -> L1 understates {100*(1-s1/s5):.0f}%")

print("\n#13 EFFECTIVE SAMPLE (dependence-adjusted) for the payoff")
for m in ['persistence','logistic','markov']:
    pv=(2*(gc['p_'+m].values>0.5)-1)*np.clip(dart,-np.quantile(a,0.99),np.quantile(a,0.99))
    se_i=pv.std(ddof=1)/np.sqrt(N); ne=N/(se_block(pv,5)/se_i)**2; print(f"   {m:12} n_eff(payoff)={ne:.0f}  (nominal N={N})")

if A.pjm_raw:
    print("\n#2 FORWARD PREMIUM on the FULL spread (raw PJM total LMP)")
    P=A.pjm_raw.rstrip('/'); nodes=sorted(pd.read_csv(D+'panel_dedup_all.csv').pnode_id.astype(str)); r=[]
    for n in nodes:
        da=pd.concat([pd.read_csv(f) for f in glob.glob(f'{P}/da_hourly/pnode={n}/*.csv')],ignore_index=True)
        rt=pd.concat([pd.read_csv(f) for f in glob.glob(f'{P}/rt_hourly/pnode={n}/*.csv')],ignore_index=True)
        mm=da[['datetime_beginning_utc','total_lmp_da']].merge(rt[['datetime_beginning_utc','total_lmp_rt']],on='datetime_beginning_utc'); r.append(mm)
    m=pd.concat(r); m['dt']=pd.to_datetime(m.datetime_beginning_utc); oos=m[(m.dt>='2026-01-01')&(m.dt<'2026-07-01')]
    tot=(oos.total_lmp_da-oos.total_lmp_rt).values
    print(f"   full-spread up-rate = {100*np.mean(tot>0):.1f}%  (text 66.6%) ; always-long win@Q99 = {np.clip(tot,-np.quantile(np.abs(tot),.99),np.quantile(np.abs(tot),.99)).mean():+.2f}")
    print("   cap sensitivity (value at cap = Q of |dart|):")
    for qq in (0.90,0.95,0.99,0.995): c=np.quantile(np.abs(tot),qq); print(f"      Q{qq}: cap=${c:.0f}  value={np.clip(tot,-c,c).mean():+.2f}")
print("\nDONE.")
