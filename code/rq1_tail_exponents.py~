#!/usr/bin/env python3
"""Heavy-tail characterisation of the congestion spread (Hill tail index).

Replication package for the manuscript on directional forecasting of PJM
day-ahead / real-time congestion spreads (submitted to *Energy Economics*).

Purpose
    Independently recompute the upper- and lower-tail Hill index of the nodal
    congestion spread and compare with the shipped RQ1 estimates. Confirms the
    finite-variance-boundary finding (alpha ~ 1.5).

Inputs
    --raw RAW_DIR/da_hourly/pnode=<id>/*.csv , RAW_DIR/rt_hourly/pnode=<id>/*.csv
        Raw PJM hourly LMP with `congestion_price_da` / `congestion_price_rt`.
    --data DATA_DIR/rq1_by_node.csv   (shipped estimates for comparison)
    --data DATA_DIR/panel_dedup_all.csv (18-node evaluation panel)

Outputs (stdout)
    Per node: recomputed plain Hill alpha vs the shipped estimate and its CI.

Usage
    python3 rq1_tail_exponents.py --data ./data --raw ./pjm_raw

Reproducibility
    Deterministic. The number of upper/lower exceedances k is taken from the
    shipped `n_exceed_upper` / `n_exceed_lower` so the threshold matches.

Note
    The manuscript's published alpha uses a drift-corrected Hill estimator
    (column `hill_upper_drift`); the plain Hill recomputed here is expected to
    fall within the shipped CI but not to be bit-identical.
"""
from __future__ import annotations

import argparse
import glob
import os

import numpy as np
import pandas as pd


def congestion_spread(raw_dir: str, node: str) -> np.ndarray:
    """Return the hourly congestion spread (DA minus RT) for one node."""
    da = pd.concat(
        [pd.read_csv(f) for f in glob.glob(f"{raw_dir}/da_hourly/pnode={node}/*.csv")],
        ignore_index=True,
    )
    rt = pd.concat(
        [pd.read_csv(f) for f in glob.glob(f"{raw_dir}/rt_hourly/pnode={node}/*.csv")],
        ignore_index=True,
    )
    merged = da[["datetime_beginning_utc", "congestion_price_da"]].merge(
        rt[["datetime_beginning_utc", "congestion_price_rt"]],
        on="datetime_beginning_utc",
    )
    spread = merged["congestion_price_da"] - merged["congestion_price_rt"]
    return spread.to_numpy()


def hill_alpha(sample: np.ndarray, k: int) -> float:
    """Plain Hill estimator of the tail index from the top-k order statistics."""
    positive = np.sort(sample[sample > 0])[::-1]
    k = min(k, positive.size - 1)
    return 1.0 / np.mean(np.log(positive[:k] / positive[k]))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--data", default="./data", help="directory with shipped CSVs")
    parser.add_argument("--raw", required=True, help="raw PJM LMP directory")
    args = parser.parse_args()

    rq1 = pd.read_csv(f"{args.data}/rq1_by_node.csv")
    panel = pd.read_csv(f"{args.data}/panel_dedup_all.csv")
    nodes = [
        str(n) for n in panel["pnode_id"]
        if os.path.isdir(f"{args.raw}/da_hourly/pnode={n}")
    ]

    print("Upper-tail Hill index of the congestion spread (k = shipped n_exceed_upper)")
    print(f"    {'node':>12}  {'Hill (recomputed)':>18}  {'shipped alpha':>13}  {'shipped 95% CI':>16}")
    inside = total = 0
    for node in nodes:
        row = rq1[(rq1["pnode_id"] == int(node)) & (rq1["component"] == "congestion")]
        if row.empty:
            continue
        k = int(row["n_exceed_upper"].iloc[0])
        alpha = hill_alpha(congestion_spread(args.raw, node), k)
        lo, hi = row["hill_upper_a_lo"].iloc[0], row["hill_upper_a_hi"].iloc[0]
        inside += lo <= alpha <= hi
        total += 1
        print(f"    {node:>12}  {alpha:>18.3f}  {row['hill_upper_a'].iloc[0]:>13.3f}"
              f"  [{lo:.2f}, {hi:.2f}]")
    print(f"\n    {inside}/{total} nodes within the shipped CI; all alpha ~ 1.5 "
          "(heavy-tailed, near the finite-variance boundary).")


if __name__ == "__main__":
    main()
