"""
Tuned HistGBM — Paper A's leak-free strong comparator (handover v2 §0.2).

Hyperparameters chosen by EXPANDING-WINDOW TimeSeriesSplit CV on the TRAINING
data only; the OOS window is never touched during selection. Paper A anchors:
    2026-H1 (train -> 2025-12-31): OOS acc 0.579, excess over A_0^z +0.006 (p=0.25)
    2025-H2 (train -> 2025-06-30): OOS acc 0.594, excess -0.026
Neither shows demonstrable skill or value; both fail by the same tail mechanism.

Paper B must clear THIS model, not only the nine untuned anchors.

    python -m models.gbm_tuned                       # 2026-H1 (main OOS)
    python -m models.gbm_tuned 2025-06-30 2025-12-31 gbm_tuned_2025H2 preds_2025H2
"""
from __future__ import annotations
import sys, os, time, itertools
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import numpy as np, pandas as pd
import data as D

from sklearn.ensemble import HistGradientBoostingClassifier
from sklearn.model_selection import TimeSeriesSplit
from sklearn.metrics import log_loss

# Pre-registered search grid (fixed before running; reported in full).
GRID = dict(
    learning_rate=[0.03, 0.1],
    max_leaf_nodes=[15, 31],
    min_samples_leaf=[20, 100],
    l2_regularization=[0.0, 1.0],
)
MAX_ITER = 200
N_SPLITS = 3            # expanding-window folds on train only


def _configs():
    keys = list(GRID)
    return [dict(zip(keys, v)) for v in itertools.product(*(GRID[k] for k in keys))]


def tune(Xtr, ytr, seed, n_splits=N_SPLITS, verbose=True):
    """Expanding-window CV on train only. Returns (best_cfg, table)."""
    tscv = TimeSeriesSplit(n_splits=n_splits)
    rows = []
    for i, cfg in enumerate(_configs()):
        losses = []
        for tr_ix, va_ix in tscv.split(Xtr):
            m = HistGradientBoostingClassifier(max_iter=MAX_ITER, random_state=seed,
                                               early_stopping=False, **cfg)
            m.fit(Xtr[tr_ix], ytr[tr_ix])
            losses.append(log_loss(ytr[va_ix], m.predict_proba(Xtr[va_ix])[:, 1],
                                   labels=[0, 1]))
        rows.append({**cfg, "cv_logloss": float(np.mean(losses))})
        if verbose:
            print(f"  [{i+1:2d}/{len(_configs())}] {cfg} -> {np.mean(losses):.5f}", flush=True)
    tab = pd.DataFrame(rows).sort_values("cv_logloss").reset_index(drop=True)
    best = {k: tab.loc[0, k] for k in GRID}
    best["max_leaf_nodes"] = int(best["max_leaf_nodes"])
    best["min_samples_leaf"] = int(best["min_samples_leaf"])
    return best, tab


def run(train_end=D.TRAIN_END, test_end=None, name="gbm_tuned",
        preds_dir=D.PREDS_DIR, panel=None, seed=D.SEED):
    t0 = time.time()
    if panel is None:
        panel = D.build_s0_panel()
    tr, te = D.split(panel, train_end=train_end)
    if test_end is not None:                     # bound the OOS window (e.g. 2025-H2)
        te = te[te["date"] <= pd.Timestamp(test_end, tz="UTC").normalize()].copy()
    tr = tr.sort_values(D.KEY)                   # time order for expanding-window CV
    feat = D.FEATURES
    Xtr = tr[feat].to_numpy(float); ytr = tr["y"].to_numpy(int)
    Xte = te[feat].to_numpy(float); yte = te["y"].to_numpy(int)
    print(f"train rows={len(tr):,}  test rows={len(te):,}  "
          f"(train->{train_end}, test->{test_end or 'end'})")

    best, tab = tune(Xtr, ytr, seed)
    print(f"\nbest config: {best}  (cv_logloss={tab.loc[0,'cv_logloss']:.5f}, "
          f"runner-up {tab.loc[1,'cv_logloss']:.5f})")

    m = HistGradientBoostingClassifier(max_iter=MAX_ITER, random_state=seed,
                                       early_stopping=False, **best)
    m.fit(Xtr, ytr)                              # refit on ALL train with locked config
    p = m.predict_proba(Xte)[:, 1]
    acc = ((p > 0.5).astype(int) == yte).mean()

    # zone-conditional comparator on THIS window
    zz = pd.DataFrame({"y": yte, "zone": te["zone"].to_numpy()})
    a0z = sum(max(g.y.mean(), 1 - g.y.mean()) * len(g) for _, g in zz.groupby("zone")) / len(zz)
    print(f"\nOOS acc = {acc:.4f}   A_0^z = {a0z:.4f}   excess = {acc - a0z:+.4f}")

    path = D.write_predictions(te, name, p, preds_dir=preds_dir)
    os.makedirs(os.path.join(os.path.dirname(__file__), "..", "..", "results"), exist_ok=True)
    tab.to_csv(os.path.join(os.path.dirname(__file__), "..", "..", "results",
                            f"{name}_search.csv"), index=False)
    print(f"wrote {path}  [{time.time()-t0:.0f}s]")
    return acc, a0z


if __name__ == "__main__":
    a = sys.argv[1:]
    run(train_end=a[0] if len(a) > 0 else D.TRAIN_END,
        test_end=a[1] if len(a) > 1 else None,
        name=a[2] if len(a) > 2 else "gbm_tuned",
        preds_dir=(os.path.join(os.path.dirname(__file__), "..", "..", a[3])
                   if len(a) > 3 else D.PREDS_DIR))
